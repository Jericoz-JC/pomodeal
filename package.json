{
  "name": "pomodeal",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:convex": "convex dev",
    "build": "node scripts/ci-build.mjs",
    "build:web": "npm run build -w apps/web",
    "test": "npm test -w packages/core",
    "test:convex": "vitest run --config convex/vitest.config.ts",
    "typecheck": "tsc -p packages/core && tsc -p apps/web && tsc -p convex",
    "shoot": "node prototypes/shoot.mjs",
    "build:ci": "node scripts/ci-build.mjs"
  },
  "dependencies": {
    "convex": "^1.49.0",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/web-push": "^3.6.4",
    "convex-test": "^0.0.67",
    "vitest": "^5.1.0"
  }
}
